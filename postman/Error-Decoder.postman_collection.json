{
  "info": {
    "name": "Error Decoder \u2014 public API verification",
    "description": "Curated retrieval with a saved normalizer + TF-IDF pipeline. Set base_url to the deployed Modal HTTPS URL. No authentication is required by this API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://juanthom99--error-decoder-api.modal.run"
    }
  ],
  "item": [
    {
      "name": "Health \u2014 ready",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Ready', () => pm.expect(data.status).to.eql('ready'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Pipeline \u2014 fitted metadata",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/pipeline-info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('1000-entry corpus', () => pm.expect(data.corpus_size).to.eql(1000));",
              "pm.test('Saved pipeline', () => { pm.expect(data.fitted).to.eql(true); pm.expect(data.serving_refits).to.eql(false); pm.expect(data.steps.map(s => s.class)).to.eql(['ErrorTextNormalizer', 'TfidfVectorizer']); });",
              "pm.test('Version and timestamp', () => { pm.expect(data.sklearn_version).to.eql('1.9.1'); pm.expect(Number.isNaN(Date.parse(data.build_timestamp))).to.eql(false); pm.expect(data.vocabulary_size).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid search \u2014 module missing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"ModuleNotFoundError: No module named 'requests'\",\n  \"top_k\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Three results', () => pm.expect(data.results).to.have.lengthOf(3));",
              "pm.test('Relevant first match', () => pm.expect(data.results[0].title).to.eql('Missing installed module'));",
              "pm.test('Ranked similarity scores and entry content', () => { let previous = 1; data.results.forEach(r => { pm.expect(r.similarity).to.be.within(0, previous); previous = r.similarity; ['id', 'title', 'example_error', 'explanation', 'likely_cause', 'fix'].forEach(k => pm.expect(r[k]).to.be.a('string').that.is.not.empty); pm.expect(r.tags).to.be.an('array'); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid search \u2014 pandas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"ValueError: The truth value of a Series is ambiguous\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Relevant pandas match', () => pm.expect(data.results[0].title).to.eql('Ambiguous Series truth'));",
              "pm.test('Ranked similarity scores and entry content', () => { let previous = 1; data.results.forEach(r => { pm.expect(r.similarity).to.be.within(0, previous); previous = r.similarity; ['id', 'title', 'example_error', 'explanation', 'likely_cause', 'fix'].forEach(k => pm.expect(r[k]).to.be.a('string').that.is.not.empty); pm.expect(r.tags).to.be.an('array'); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown vocabulary \u2014 empty results",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"zxqvblrp qqqzzzyyy\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Clear no-match result', () => { pm.expect(data.results).to.eql([]); pm.expect(data.message).to.include('No matching vocabulary'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid \u2014 blank text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \" \\n\\t\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
              "const data = pm.response.json();",
              "pm.test('Validation details', () => { pm.expect(data.detail).to.be.an('array').that.is.not.empty; data.detail.forEach(e => pm.expect(e).not.to.have.property('input')); });"
            ]
          }
        }
      ]
    },
